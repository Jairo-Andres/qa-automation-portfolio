                "type": "text/javascript",
                "exec": [
                  "// Lo correcto sería 400 Bad Request; la API devuelve 500 (ver BUGS.md).",
                  "// El test verifica que la petición se rechaza, sin dar por bueno el 500.",
                  "pm.test(\"La petición es rechazada (no 2xx)\", () => {",
                  "    pm.expect(pm.response.code).to.be.at.least(400);",
                  "});",
                  "pm.test(\"No se crea ninguna reserva\", () => {",
                  "    pm.expect(pm.response.text()).to.not.include(\"bookingid\");",
                  "});"
